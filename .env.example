# ============================================================
# Swiss Energy Assistant — Environment Configuration
# Copy this file to .env and fill in real values
# ============================================================

# -- Application --
APP_NAME=swiss-energy-assistant
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-random-secret-key-in-production

# -- Database --
POSTGRES_USER=sea_user
POSTGRES_PASSWORD=sea_password
POSTGRES_DB=sea_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# -- Redis (optional caching/queue) --
REDIS_URL=redis://redis:6379/0

# -- Auth (JWT) --
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# -- Provider APIs (fill only when you have permission) --
CKW_API_BASE_URL=https://e-ckw-public-data.de-c1.eu1.cloudhub.io/api/v1
CKW_API_KEY=
GROUPE_E_API_BASE_URL=https://api.tariffs.groupe-e.ch/v2
GROUPE_E_API_KEY=
EKZ_API_BASE_URL=
PRIMEO_API_BASE_URL=https://tarife.primeo-energie.ch/api/v1

# -- Push Notifications --
FCM_SERVER_KEY=
FCM_PROJECT_ID=

# -- Frontend --
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCK_API=true

# -- Monitoring (optional) --
SENTRY_DSN=
